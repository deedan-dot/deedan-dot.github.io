    src="https://livescore.soccersapi.com/livescore-widget"
    width="100%"
    height="500"
    frameborder="0">
  </iframe>
</section>

<footer>
  <p>© 2026 Daviscore Lente</p>
</footer>

<script src="script.js"></script>
</body>
</html>
